ACCESS_CONTROL_VENDOR=zkbio

# ZKBioCVSecurity Configuration (when ACCESS_CONTROL_VENDOR=zkbio)
BIOCV_BASE_URL=http://192.168.1.100:8088
BIOCV_ACCESS_TOKEN=your_access_token_here
ZKBIO_ACCESS_LEVEL_ID=402881849822a287019822c6629015ab
ZKBIO_DEPT_CODE=1

# Gym Management System API Configuration
GMS_API_URL=http://localhost:3000/api/access-control/members?offset=0
GMS_API_KEY=ac_dev_key_2024
GYM_API_SOURCE=fitness254
# GYM_API_SOURCE options: fitness254 | gymmaster (default: fitness254)
GYM_NAME=Empire Fitness
GYM_EMAIL_DOMAIN=gym.local

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Sync Configuration (Optional - defaults shown)
SYNC_INTERVAL_MS=90000
SYNC_BATCH_SIZE=300
SYNC_BATCH_DELAY_MS=100
SYNC_OPERATION_DELAY_MS=100

# Notification Configuration (Optional - defaults shown)
HEARTBEAT_SCHEDULE=30 20 * * *
HEARTBEAT_TIMEZONE=Africa/Nairobi

HIK_BASE_URL=http://192.168.1.200:443
HIK_APP_KEY=your_hik_app_key_here
HIK_APP_SECRET=your_hik_app_secret_here
HIK_ORG_INDEX_CODE=your_default_org_index_code_here
HIK_WOMEN_ORG_INDEX_CODE=your_women_org_index_code_here
HIK_PRIVILEGE_GROUP_ID=your_default_privilege_group_id_here
HIK_WOMEN_PRIVILEGE_GROUP_ID=your_women_privilege_group_id_here

# Gender-Based Separation (Optional - for ladies/men separation)
ZKBIO_WOMEN_DEPT_CODE=2
ZKBIO_WOMEN_ACCESS_LEVEL_ID=your_women_access_level_id_here
